<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.shop.mapper.UserMapper">
    <select id="selectById" resultType="string">
        select name from t_user where id = #{id}
    </select>
    <select id="selectByName" resultType="string">
        select name from t_user where name = #{name}
    </select>
    <select id="selectByEmail" resultType="string">
        select name from t_user where email = #{email}
    </select>
</mapper>
