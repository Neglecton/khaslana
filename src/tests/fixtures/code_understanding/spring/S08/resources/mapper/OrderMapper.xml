<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.shop.mapper.OrderMapper">
    <sql id="activeFilter">status = 'ACTIVE'</sql>
    <sql id="baseColumns">id, user_id, status</sql>
    <sql id="cycleA"><include refid="cycleB"/></sql>
    <sql id="cycleB"><include refid="cycleA"/></sql>
    <include refid="activeFilter"/>
    <select id="listActive" resultType="string">
        select
        <include refid="baseColumns"/>
        from t_order
        where
        <include refid="activeFilter"/>
        <if test="status != null">
            and status = #{status}
        </if>
        <if test="ids != null">
            and id in
            <foreach collection="ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>
    </select>
</mapper>
