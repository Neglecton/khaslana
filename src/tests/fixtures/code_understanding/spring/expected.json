          "target": "com.example.web.CombinedController#ping()",
          "certainty": "inferred",
          "rule": "spring.composed_mapping",
          "note": "ApiGet 基于允许元注解的 @RequestMapping(method=GET)，可静态识别 GET 路由",
          "source": {
            "owner": "com.example.web.CombinedController#ping()",
            "path": "S02/com/example/web/CombinedController.java",
            "callee": "HTTP GET /combined/ping",
