          "kind": "handles",
          "call_site": "HTTP GET /combined/inherited",
          "source": {
            "owner": "com.example.web.CombinedContract#inherited()",
            "path": "S02/com/example/web/CombinedContract.java",
            "callee": "@GetMapping(\"/combined/inherited\")",
            "occurrence": 1,
            "anchor": "@GetMapping(\"/combined/inherited\")"
          },
          "target": "com.example.web.CombinedController#inherited()",
          "certainty": "inferred",
          "rule": "spring.interface_mapping_inheritance",
          "note": "路由声明位于 CombinedContract 接口方法，Controller 实现方法继承该映射"
        }
