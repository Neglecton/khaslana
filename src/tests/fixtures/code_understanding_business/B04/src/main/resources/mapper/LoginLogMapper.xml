<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.report.mapper.LoginLogMapper">
    <insert id="insertLog">
        INSERT INTO report_login_log (username, result, created_at)
        VALUES (#{username}, #{result}, NOW())
    </insert>
</mapper>
